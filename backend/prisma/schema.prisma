model SocLog {
  id        String    @id @default(uuid())
  source    LogSource @default(APPLICATION)
  level     LogLevel  @default(INFO)
  message   String
  hostname  String?
  service   String?
  ip        String?
  userId    String?
  sessionId String?
  requestId String?
  eventType String?
  rawData   Json?
  tags      Json?
  createdAt DateTime  @default(now())

  @@index([source, level, createdAt])
  @@index([createdAt])
  @@index([ip, createdAt])
  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model SiemConfig {
  id                String   @id @default("singleton")
  enabled           Boolean  @default(false)
  sources           Json?
  alertThreshold    Int      @default(10)
  enrichmentEnabled Boolean  @default(false)
  vtApiKey          String?
  abuseApiKey       String?
  gnApiKey          String?
  edrWebhookUrl     String?
  edrWebhookSecret  String?
  retentionDays     Int      @default(90)
  updatedById       String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
  updatedBy         User?    @relation("SiemConfigUpdater", fields: [updatedById], references: [id])
}

model LogCollectionSource {
  id         String   @id @default(uuid())
  name       String   @unique
  type       String
  enabled    Boolean  @default(true)
  endpoint   String?
  apiKey     String?
  format     String   @default("json")
  filters    Json?
  lastSeenAt DateTime?
  eventCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


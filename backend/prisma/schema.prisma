// ─────────────────────────────────────────────────────────────────────────────
// SOC CASE MANAGEMENT MODELS
// ─────────────────────────────────────────────────────────────────────────────

model SocCase {
  id              String              @id @default(uuid())
  caseNumber      String              @unique
  title           String
  description     String?
  severity        CaseSeverity        @default(MEDIUM)
  priority        CasePriority        @default(MEDIUM)
  status          CaseStatus          @default(OPEN)
  source          String?
  sourceEventId   String?
  detectionRule   String?
  threatScore     Int                 @default(0)
  confidence      Int                 @default(0)
  impact          String?
  rootSuspicion   String?
  slaDeadline     DateTime?
  closedAt        DateTime?
  mitreaTactics   Json?
  tags            Json?
  createdById     String
  updatedById     String?
  assigneeId      String?
  createdBy       User                @relation("SocCaseCreator", fields: [createdById], references: [id])
  updatedBy       User?               @relation("SocCaseUpdater", fields: [updatedById], references: [id])
  assignee        User?               @relation("SocCaseAssignee", fields: [assigneeId], references: [id])
  timeline        SocCaseTimeline[]
  evidence        SocCaseEvidence[]
  iocs            SocCaseIoc[]
  notes           SocCaseNote[]
  auditEntries    SocCaseAudit[]
  affectedAssets  SocCaseAsset[]
  affectedUsers   SocCaseUser[]
  playbookRuns    SocPlaybookRun[]
  responseActions SocResponseAction[]
  relatedCases    SocCaseRelated[]    @relation("PrimaryCase")
  relatedTo       SocCaseRelated[]    @relation("RelatedCase")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, priority, createdAt])
  @@index([severity, createdAt])
  @@index([assigneeId, status])
  @@index([sourceEventId])
  @@index([status, slaDeadline])
}

model SocCaseTimeline {
  id          String   @id @default(uuid())
  caseId      String
  eventType   String
  description String
  actorId     String?
  actorName   String?
  source      String?
  metadata    Json?
  createdAt   DateTime @default(now())
  case        SocCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model SocCaseEvidence {
  id           String       @id @default(uuid())
  caseId       String
  name         String
  type         EvidenceType
  source       String?
  fileHash     String?
  filePath     String?
  fileSize     Int?
  integrity    String       @default("UNVERIFIED")
  uploadedById String?
  metadata     Json?
  createdAt    DateTime     @default(now())
  case         SocCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model SocCaseIoc {
  id          String   @id @default(uuid())
  caseId      String
  indicator   String
  type        IocType
  reputation  IocRep   @default(UNKNOWN)
  threatScore Int      @default(0)
  vtResult    Json?
  abuseResult Json?
  gnResult    Json?
  enrichedAt  DateTime?
  firstSeen   DateTime?
  lastSeen    DateTime?
  addedById   String?
  createdAt   DateTime @default(now())
  case        SocCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, type])
  @@index([indicator])
}

model SocCaseNote {
  id         String   @id @default(uuid())
  caseId     String
  channel    String   @default("INTERNAL")
  content    String
  authorId   String
  authorName String?
  mentions   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  case       SocCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author     User     @relation("SocCaseNoteAuthor", fields: [authorId], references: [id])

  @@index([caseId, channel, createdAt])
}

model SocCaseAudit {
  id        String   @id @default(uuid())
  caseId    String
  actorId   String?
  actorName String?
  actorIp   String?
  action    String
  details   Json?
  createdAt DateTime @default(now())
  case      SocCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model SocCaseAsset {
  id         String   @id @default(uuid())
  caseId     String
  name       String
  type       String
  riskLevel  String   @default("MEDIUM")
  hostname   String?
  ipAddress  String?
  eventCount Int      @default(0)
  metadata   Json?
  createdAt  DateTime @default(now())
  case       SocCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model SocCaseUser {
  id           String   @id @default(uuid())
  caseId       String
  userId       String?
  email        String
  name         String?
  role         String?
  riskScore    Int      @default(0)
  failedLogins Int      @default(0)
  mfaEnabled   Boolean  @default(false)
  createdAt    DateTime @default(now())
  case         SocCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model SocCaseRelated {
  id            String   @id @default(uuid())
  primaryCaseId String
  relatedCaseId String
  relationship  String
  similarity    Int      @default(0)
  createdAt     DateTime @default(now())
  primaryCase   SocCase  @relation("PrimaryCase", fields: [primaryCaseId], references: [id], onDelete: Cascade)
  relatedCase   SocCase  @relation("RelatedCase", fields: [relatedCaseId], references: [id], onDelete: Cascade)

  @@unique([primaryCaseId, relatedCaseId])
  @@index([primaryCaseId])
}

model SocPlaybook {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  category    String?
  steps       Json
  autoRun     Boolean          @default(false)
  active      Boolean          @default(true)
  runs        SocPlaybookRun[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model SocPlaybookRun {
  id          String         @id @default(uuid())
  caseId      String
  playbookId  String
  status      PlaybookStatus @default(IDLE)
  currentStep Int            @default(0)
  stepResults Json?
  startedById String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  case        SocCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  playbook    SocPlaybook    @relation(fields: [playbookId], references: [id])
  startedBy   User?          @relation("SocPlaybookRunStarter", fields: [startedById], references: [id])

  @@index([caseId, status])
}

model SocResponseAction {
  id           String         @id @default(uuid())
  caseId       String
  actionType   String
  target       String?
  reason       String?
  status       ResponseStatus @default(PENDING)
  executedById String?
  executedAt   DateTime?
  result       Json?
  createdAt    DateTime       @default(now())
  case         SocCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  executedBy   User?          @relation("SocResponseActionExecutor", fields: [executedById], references: [id])

  @@index([caseId, status])
}

